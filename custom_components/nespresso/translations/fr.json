        "security": {
          "name": "Sécurité",
          "description": "Le type de sécurité du réseau."
        },
        "connection_index": {
          "name": "Index de connexion",
          "description": "Reprendre l'index d'un résultat de recherche. Laisser à 255 en saisie manuelle."
        }
      }
    },
    "send_command": {
      "name": "Envoyer une commande brute",
      "description": "Écrit une trame brute sur la caractéristique de commande de la machine et rapporte la réponse. Outil de diagnostic : il indique ce que proposent les deux caractéristiques et si la machine pouvait répondre, ce qui distingue une commande refusée d'une commande que la machine ne peut pas acquitter.",
      "fields": {
        "config_entry_id": {
          "name": "Machine",
          "description": "La machine Nespresso concernée."
        },
        "payload": {
          "name": "Trame",
          "description": "La trame à écrire, en hexadécimal. Exemple 03050704000000000002000000000000000000, un lungo Vertuo à température moyenne."
        }
      }
    },
    "watch": {
      "name": "Observer la machine",
      "description": "Garde la connexion ouverte et enregistre tout ce qui change : chaque caractéristique dont la valeur change et chaque notification, horodatées. Lancez-la, puis utilisez la machine à la main. C'est ainsi que les caractéristiques dont l'application officielle ne parle jamais sont identifiées.",
      "fields": {
        "config_entry_id": {
          "name": "Machine",
          "description": "La machine Nespresso concernée."
        },
