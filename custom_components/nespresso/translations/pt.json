  "services": {
    "scan_wifi": {
      "name": "Pesquisar redes Wi-Fi",
      "description": "Pergunta à máquina que redes Wi-Fi consegue ver. É a máquina que faz a pesquisa, não o Home Assistant, por isso a lista corresponde ao que a máquina consegue alcançar.",
