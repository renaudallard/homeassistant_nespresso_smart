        "config_entry_id": {
          "name": "Máquina",
          "description": "A máquina Nespresso sobre a qual atuar."
        }
      }
    },
    "configure_wifi": {
      "name": "Configurar o Wi-Fi",
      "description": "Liga a máquina a uma rede Wi-Fi. A palavra-passe é enviada à máquina em texto simples, exatamente como a aplicação oficial Nespresso a envia. Acompanhe o resultado no sensor Estado do Wi-Fi.",
      "fields": {
        "config_entry_id": {
          "name": "Máquina",
          "description": "A máquina Nespresso sobre a qual atuar."
        },
        "market": {
          "name": "Mercado",
          "description": "Código de país de duas letras, por exemplo PT. Sem ele, a máquina não conseguirá chegar aos servidores da Nespresso."
        },
        "ssid": {
          "name": "Nome da rede",
          "description": "O SSID ao qual ligar, no máximo 32 bytes."
        },
        "password": {
          "name": "Palavra-passe",
          "description": "No máximo 64 bytes. Deixe vazio para uma rede aberta."
        },
        "security": {
          "name": "Segurança",
          "description": "O tipo de segurança da rede."
        },
        "connection_index": {
          "name": "Índice de ligação",
          "description": "Repita o índice de um resultado da pesquisa. Deixe em 255 ao introduzir a rede manualmente."
        }
      }
    },
    "send_command": {
      "name": "Enviar um comando em bruto",
      "description": "Escreve uma trama em bruto na característica de comando da máquina e indica o que foi devolvido. Uma ferramenta de depuração: indica o que ambas as características oferecem e se a máquina conseguiu sequer responder, o que permite distinguir um comando recusado de um que a máquina não consegue confirmar.",
      "fields": {
        "config_entry_id": {
          "name": "Máquina",
          "description": "A máquina Nespresso sobre a qual atuar."
        },
        "payload": {
          "name": "Payload",
          "description": "A trama a escrever, em hexadecimal. Exemplo 03050704000000000002000000000000000000, um lungo Vertuo a temperatura média."
        }
      }
    },
    "watch": {
      "name": "Observar a máquina",
      "description": "Mantém a ligação aberta e regista tudo o que se altera: cada característica que muda de valor e cada notificação, com carimbo de data/hora. Execute a ação e, em seguida, utilize a máquina manualmente. É assim que se identificam as características que a aplicação oficial nunca menciona.",
      "fields": {
        "config_entry_id": {
          "name": "Máquina",
          "description": "A máquina Nespresso sobre a qual atuar."
        },
        "seconds": {
          "name": "Duração",
          "description": "Durante quanto tempo observar, em segundos. Tempo suficiente para cobrir um ciclo inteiro, de preparação ou de espuma."
