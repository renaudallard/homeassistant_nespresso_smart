    "send_command": {
      "name": "Nyers parancs küldése",
      "description": "Nyers keretet ír a készülék parancskarakterisztikájára, és jelenti, mi érkezett vissza. Hibakereső eszköz: megmondja, mit kínál a két karakterisztika, és hogy a készülék egyáltalán tudott-e válaszolni, és éppen ebből különböztethető meg egy elutasított parancs attól, amelyet a készülék nem tud nyugtázni.",
      "fields": {
        "config_entry_id": {
