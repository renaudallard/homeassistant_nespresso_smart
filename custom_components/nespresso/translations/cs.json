        }
      }
    },
    "send_command": {
      "name": "Odeslat surový příkaz",
      "description": "Zapíše surový rámec do příkazové charakteristiky kávovaru a ohlásí, co se vrátilo. Ladicí nástroj: uvádí, co obě charakteristiky nabízejí a zda kávovar vůbec mohl odpovědět, a právě podle toho se rozliší odmítnutý příkaz od příkazu, který kávovar nedokáže potvrdit.",
      "fields": {
        "config_entry_id": {
          "name": "Kávovar",
          "description": "Kávovar Nespresso, se kterým se má pracovat."
        },
        "payload": {
          "name": "Datová část",
          "description": "Rámec k zápisu, v hexadecimálním tvaru. Příklad 03050704000000000002000000000000000000, Vertuo lungo při střední teplotě."
        }
      }
    },
    "watch": {
      "name": "Sledovat kávovar",
      "description": "Udržuje spojení otevřené a zaznamenává vše, co se mění: každou charakteristiku, jejíž hodnota se změní, a každé oznámení, s časovým razítkem. Spusťte ji a pak kávovar ovládejte ručně. Takto se identifikují charakteristiky, o kterých se oficiální aplikace nikdy nezmiňuje.",
      "fields": {
        "config_entry_id": {
          "name": "Kávovar",
          "description": "Kávovar Nespresso, se kterým se má pracovat."
        },
        "seconds": {
          "name": "Doba trvání",
