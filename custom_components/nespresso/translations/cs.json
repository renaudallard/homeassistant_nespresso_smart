  "services": {
    "scan_wifi": {
      "name": "Vyhledat sítě Wi-Fi",
      "description": "Zeptá se kávovaru, které sítě Wi-Fi vidí. Vyhledávání provádí kávovar, ne Home Assistant, takže seznam ukazuje to, na co kávovar dosáhne.",
