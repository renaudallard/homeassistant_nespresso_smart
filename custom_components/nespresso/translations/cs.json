    "configure_wifi": {
      "name": "Nastavit Wi-Fi",
      "description": "Připojí kávovar k síti Wi-Fi. Heslo se do kávovaru odesílá nešifrovaně, přesně tak, jak ho odesílá oficiální aplikace Nespresso. Výsledek sledujte na senzoru Stav Wi-Fi.",
      "fields": {
        "config_entry_id": {
          "name": "Kávovar",
          "description": "Kávovar Nespresso, se kterým se má pracovat."
