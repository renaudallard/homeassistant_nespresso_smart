          "name": "Heslo",
          "description": "Nejvýše 64 bajtů. U otevřené sítě nechte prázdné."
        },
        "security": {
          "name": "Zabezpečení",
          "description": "Typ zabezpečení sítě."
        },
        "connection_index": {
          "name": "Index připojení",
