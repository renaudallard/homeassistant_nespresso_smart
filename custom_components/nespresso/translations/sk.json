    "send_command": {
      "name": "Odoslať surový príkaz",
      "description": "Zapíše surový rámec do príkazovej charakteristiky kávovaru a oznámi, čo sa vrátilo. Ladiaci nástroj: uvádza, čo obe charakteristiky ponúkajú a či kávovar vôbec mohol odpovedať, a práve podľa toho sa rozlíši odmietnutý príkaz od príkazu, ktorý kávovar nedokáže potvrdiť.",
      "fields": {
        "config_entry_id": {
          "name": "Kávovar",
          "description": "Kávovar Nespresso, s ktorým sa má pracovať."
        },
        "payload": {
          "name": "Dátová časť",
          "description": "Rámec na zápis, v hexadecimálnom tvare. Príklad 03050704000000000002000000000000000000, Vertuo lungo pri strednej teplote."
        }
      }
    },
    "watch": {
      "name": "Sledovať kávovar",
      "description": "Udržiava spojenie otvorené a zaznamenáva všetko, čo sa mení: každú charakteristiku, ktorej hodnota sa zmení, a každé oznámenie, s časovou pečiatkou. Spustite ju a potom kávovar ovládajte ručne. Takto sa identifikujú charakteristiky, o ktorých sa oficiálna aplikácia nikdy nezmieňuje.",
      "fields": {
        "config_entry_id": {
          "name": "Kávovar",
          "description": "Kávovar Nespresso, s ktorým sa má pracovať."
        },
        "seconds": {
          "name": "Trvanie",
          "description": "Ako dlho sledovať, v sekundách. Dostatočne dlho na to, aby sa pokryl celý cyklus, príprava alebo napeňovanie."
