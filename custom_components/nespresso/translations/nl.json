  "services": {
    "scan_wifi": {
      "name": "Zoek WiFi-netwerken",
      "description": "Vraag de machine welke WiFi-netwerken zij ziet. De machine doet het zoeken, niet Home Assistant, dus de lijst is wat de machine kan bereiken.",
