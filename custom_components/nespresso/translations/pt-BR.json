  "services": {
    "scan_wifi": {
      "name": "Procurar redes Wi-Fi",
      "description": "Pergunta à máquina quais redes Wi-Fi ela consegue ver. É a máquina que faz a busca, não o Home Assistant, então a lista mostra o que a máquina consegue alcançar.",
