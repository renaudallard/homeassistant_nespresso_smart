        "config_entry_id": {
          "name": "Máquina",
          "description": "A máquina Nespresso na qual a ação será executada."
        }
      }
    },
    "configure_wifi": {
      "name": "Configurar Wi-Fi",
      "description": "Conecta a máquina a uma rede Wi-Fi. A senha é enviada à máquina em texto puro, exatamente como o aplicativo oficial da Nespresso a envia. Acompanhe o resultado no sensor Status do Wi-Fi.",
      "fields": {
        "config_entry_id": {
          "name": "Máquina",
          "description": "A máquina Nespresso na qual a ação será executada."
        },
        "market": {
          "name": "Mercado",
          "description": "Código de país de duas letras, por exemplo BR. Sem ele, a máquina não vai conseguir acessar os servidores da Nespresso."
        },
        "ssid": {
          "name": "Nome da rede",
          "description": "O SSID ao qual se conectar, no máximo 32 bytes."
        },
        "password": {
          "name": "Senha",
          "description": "No máximo 64 bytes. Deixe em branco para uma rede aberta."
        },
        "security": {
          "name": "Segurança",
          "description": "O tipo de segurança da rede."
        },
        "connection_index": {
          "name": "Índice de conexão",
          "description": "Repita o índice de um resultado da busca. Deixe em 255 ao digitar a rede manualmente."
        }
      }
    },
    "send_command": {
      "name": "Enviar um comando bruto",
      "description": "Grava um quadro bruto na característica de comando da máquina e informa o que foi retornado. Uma ferramenta de depuração: informa o que as duas características oferecem e se a máquina conseguiu responder de alguma forma, o que diferencia um comando recusado de um que a máquina não consegue confirmar.",
      "fields": {
        "config_entry_id": {
          "name": "Máquina",
          "description": "A máquina Nespresso na qual a ação será executada."
        },
        "payload": {
          "name": "Payload",
          "description": "O quadro a ser gravado, em hexadecimal. Exemplo 03050704000000000002000000000000000000, um lungo Vertuo em temperatura média."
        }
      }
    },
    "watch": {
      "name": "Monitorar a máquina",
      "description": "Mantém a conexão aberta e registra tudo o que se altera: cada característica que muda de valor e cada notificação, com carimbo de data e hora. Execute a ação e depois use a máquina manualmente. É assim que se identificam as características que o aplicativo oficial nunca menciona.",
      "fields": {
        "config_entry_id": {
          "name": "Máquina",
          "description": "A máquina Nespresso na qual a ação será executada."
        },
        "seconds": {
          "name": "Duração",
          "description": "Por quanto tempo monitorar, em segundos. Tempo suficiente para cobrir um ciclo inteiro, de preparo ou de espuma."
