        }
      }
    },
    "send_command": {
      "name": "Send en rå kommando",
      "description": "Skriv en rå ramme til maskinens kommandokarakteristik, og rapportér, hvad der kom tilbage. Et fejlfindingsværktøj: det viser, hvad begge karakteristikker understøtter, og om maskinen overhovedet kunne svare, og det er det, der skelner en afvist kommando fra en, som maskinen ikke kan bekræfte.",
      "fields": {
        "config_entry_id": {
          "name": "Maskine",
          "description": "Den Nespresso-maskine, handlingen skal udføres på."
        },
        "payload": {
          "name": "Nyttelast",
          "description": "Rammen, der skal skrives, i hexadecimal form. Eksempel: 03050704000000000002000000000000000000, en Vertuo-lungo ved middel temperatur."
        }
      }
    },
    "watch": {
      "name": "Overvåg maskinen",
      "description": "Hold forbindelsen åben, og registrer alt, der ændrer sig: hver karakteristik, der skifter værdi, og hver notifikation, med tidsstempel. Start overvågningen, og betjen derefter maskinen manuelt. Det er sådan, de karakteristikker, som den officielle app aldrig nævner, bliver identificeret.",
