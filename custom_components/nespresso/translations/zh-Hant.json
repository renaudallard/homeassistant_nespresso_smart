  "services": {
    "scan_wifi": {
      "name": "掃描 Wi-Fi 網路",
      "description": "詢問咖啡機能看到哪些 Wi-Fi 網路。掃描是由咖啡機而非 Home Assistant 執行，因此列表中是咖啡機能夠連線的網路。",
      "fields": {
        "config_entry_id": {
          "name": "咖啡機",
          "description": "要操作的 Nespresso 咖啡機。"
        }
      }
    },
    "configure_wifi": {
      "name": "設定 Wi-Fi",
      "description": "將咖啡機連線至 Wi-Fi 網路。密碼會以明文傳送至咖啡機，與官方 Nespresso App 的傳送方式完全相同。請查看 Wi-Fi 狀態感測器以取得結果。",
      "fields": {
        "config_entry_id": {
          "name": "咖啡機",
          "description": "要操作的 Nespresso 咖啡機。"
        },
        "market": {
          "name": "市場",
          "description": "兩個字母的國家代碼，例如 TW。沒有此代碼，咖啡機將無法連線至 Nespresso 的伺服器。"
        },
        "ssid": {
          "name": "網路名稱",
          "description": "要加入的 SSID，最多 32 位元組。"
        },
        "password": {
          "name": "密碼",
          "description": "最多 64 位元組。開放網路請留空。"
        },
        "security": {
          "name": "安全性",
          "description": "網路的安全性類型。"
        },
        "connection_index": {
          "name": "連線索引",
          "description": "沿用掃描結果中的索引。手動輸入網路時請保留為 255。"
        }
      }
    },
    "send_command": {
      "name": "傳送原始指令",
      "description": "將原始資料框寫入咖啡機的指令特徵值，並回報傳回的內容。這是一個除錯工具：它會顯示兩個特徵值各自提供的功能，以及咖啡機是否能夠回應，藉此區分被拒絕的指令與咖啡機無法確認收到的指令。",
      "fields": {
        "config_entry_id": {
          "name": "咖啡機",
          "description": "要操作的 Nespresso 咖啡機。"
        },
        "payload": {
          "name": "酬載",
          "description": "要寫入的資料框，以十六進位表示。例如 03050704000000000002000000000000000000，代表中溫的 Vertuo Lungo。"
        }
      }
    },
    "watch": {
      "name": "監看咖啡機",
      "description": "保持連線開啟並記錄所有變動：每一個數值改變的特徵值與每一則通知，皆附上時間戳記。執行後，請手動操作咖啡機。官方 App 從未提及的特徵值就是以這種方式辨識出來的。",
      "fields": {
        "config_entry_id": {
          "name": "咖啡機",
          "description": "要操作的 Nespresso 咖啡機。"
        },
        "seconds": {
          "name": "持續時間",
          "description": "監看的時間長度（秒）。長度需足以涵蓋整個萃取或奶泡製作循環。"
